{
  "identifier": "default",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$HOME/.codex/skills"
        },
        {
          "path": "$HOME/.codex/skills/**"
        },
        {
          "path": "$HOME/.codex/skills/.system"
        },
        {
          "path": "$HOME/.codex/skills/.system/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-lstat",
      "allow": [
        {
          "path": "$HOME/.codex/skills"
        },
        {
          "path": "$HOME/.codex/skills/**"
        },
        {
          "path": "$HOME/.codex/skills/.system"
        },
        {
          "path": "$HOME/.codex/skills/.system/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$HOME/.codex/skills"
        },
        {
          "path": "$HOME/.codex/skills/**"
        },
        {
          "path": "$HOME/.codex/skills/.system"
        },
        {
          "path": "$HOME/.codex/skills/.system/**"
        }
      ]
    },
    "fs:allow-write-text-file",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$HOME/.codex/skills"
        },
        {
          "path": "$HOME/.codex/skills/**"
        },
        {
          "path": "$HOME/.codex/skills/.system"
        },
        {
          "path": "$HOME/.codex/skills/.system/**"
        }
      ]
    },
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "sql:default",
    "sql:allow-execute",
    "dialog:allow-open",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/.claude/skills"
        },
        {
          "path": "$HOME/.claude/skills/**"
        },
        {
          "path": "$HOME/.agents/skills"
        },
        {
          "path": "$HOME/.agents/skills/**"
        }
      ],
      "deny": [
        {
          "path": "/**/.env"
        },
        {
          "path": "/**/.env.*"
        },
        {
          "path": "/**/.ssh"
        },
        {
          "path": "/**/.ssh/**"
        },
        {
          "path": "/**/.aws"
        },
        {
          "path": "/**/.aws/**"
        },
        {
          "path": "/**/.gnupg"
        },
        {
          "path": "/**/.gnupg/**"
        },
        {
          "path": "/**/.netrc"
        },
        {
          "path": "/**/.npmrc"
        },
        {
          "path": "/**/.pypirc"
        },
        {
          "path": "/**/.git/config"
        },
        {
          "path": "/**/.git/hooks"
        },
        {
          "path": "/**/.git/hooks/**"
        },
        {
          "path": "/**/.config/gh"
        },
        {
          "path": "/**/.config/gh/**"
        },
        {
          "path": "/**/.claude.json"
        },
        {
          "path": "/**/.credentials.json"
        },
        {
          "path": "/**/.credentials.*"
        },
        {
          "path": "/**/.netrc.*"
        },
        {
          "path": "/**/.git-credentials"
        },
        {
          "path": "/**/.gitconfig"
        },
        {
          "path": "/**/.docker"
        },
        {
          "path": "/**/.docker/**"
        },
        {
          "path": "/**/.kube"
        },
        {
          "path": "/**/.kube/**"
        },
        {
          "path": "/**/id_rsa"
        },
        {
          "path": "/**/id_ed25519"
        },
        {
          "path": "/**/Library/Keychains"
        },
        {
          "path": "/**/Library/Keychains/**"
        },
        {
          "path": "/**/Library/Application Support/Google/Chrome"
        },
        {
          "path": "/**/Library/Application Support/Google/Chrome/**"
        },
        {
          "path": "/**/Library/Application Support/Firefox"
        },
        {
          "path": "/**/Library/Application Support/Firefox/**"
        },
        {
          "path": "/**/Library/Safari"
        },
        {
          "path": "/**/Library/Safari/**"
        },
        {
          "path": "/**/.ENV"
        },
        {
          "path": "/**/.ENV.*"
        },
        {
          "path": "/**/.SSH"
        },
        {
          "path": "/**/.SSH/**"
        },
        {
          "path": "/**/.AWS"
        },
        {
          "path": "/**/.AWS/**"
        },
        {
          "path": "/**/.GNUPG"
        },
        {
          "path": "/**/.GNUPG/**"
        },
        {
          "path": "/**/.NETRC"
        },
        {
          "path": "/**/.NETRC.*"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$HOME/.codex/skills"
        },
        {
          "path": "$HOME/.codex/skills/**"
        },
        {
          "path": "$HOME/.codex/skills/.system"
        },
        {
          "path": "$HOME/.codex/skills/.system/**"
        }
      ]
    },
    "fs:allow-write-file"
  ]
}
