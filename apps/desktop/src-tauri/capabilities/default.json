{
  "identifier": "default",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$HOME/.codex/skills"
        },
        {
          "path": "$HOME/.codex/skills/**"
        },
        {
          "path": "$HOME/.codex/skills/.system"
        },
        {
          "path": "$HOME/.codex/skills/.system/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-lstat",
      "allow": [
        {
          "path": "$HOME/.codex/skills"
        },
        {
          "path": "$HOME/.codex/skills/**"
        },
        {
          "path": "$HOME/.codex/skills/.system"
        },
        {
          "path": "$HOME/.codex/skills/.system/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$HOME/.codex/skills"
        },
        {
          "path": "$HOME/.codex/skills/**"
        },
        {
          "path": "$HOME/.codex/skills/.system"
        },
        {
          "path": "$HOME/.codex/skills/.system/**"
        }
      ]
    },
    "fs:allow-write-text-file",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$HOME/.codex/skills"
        },
        {
          "path": "$HOME/.codex/skills/**"
        },
        {
          "path": "$HOME/.codex/skills/.system"
        },
        {
          "path": "$HOME/.codex/skills/.system/**"
        }
      ]
    },
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "sql:default",
    "sql:allow-execute",
    "dialog:allow-open",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/.claude"
        },
        {
          "path": "$HOME/.claude/**"
        },
        {
          "path": "$HOME/.agents"
        },
        {
          "path": "$HOME/.agents/**"
        }
      ]
    }
  ]
}
